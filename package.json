{
  "name": "rp-gant",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "pnpm test:unit && pnpm test:contract",
    "test:unit": "vitest run",
    "test:contract": "node tools/check-contracts.mjs",
    "test:e2e": "playwright test",
    "local:up": "node tools/local.mjs up",
    "local:down": "node tools/local.mjs down",
    "local:reset": "node tools/local.mjs reset",
    "local:status": "node tools/local.mjs status",
    "local:health": "node tools/local.mjs health",
    "local:demo": "node tools/demo.mjs",
    "local:logs": "node tools/local.mjs logs",
    "local:backup": "node tools/local.mjs backup",
    "local:restore": "node tools/local.mjs restore",
    "local:verify-restore": "node tools/restore-drill.mjs",
    "dlq:replay": "node apps/audit-service/src/replay-dlq.js",
    "backfill:task-assignments": "node tools/backfill-executor-assignments.mjs",
    "start:api-gateway": "node apps/api-gateway/src/index.js",
    "start:user-service": "node apps/user-service/src/index.js",
    "start:project-service": "node apps/project-service/src/index.js",
    "build": "pnpm -r --if-present build"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "vitest": "^5.0.5"
  }
}
